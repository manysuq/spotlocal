# SpotLocal Configuration

# Network
SPOTLOCAL_HOST=0.0.0.0
SPOTLOCAL_PORT=8000

# Paths
SPOTLOCAL_MUSIC_DIR=./music
SPOTLOCAL_DATA_DIR=./data

# spotDL Options
SPOTLOCAL_AUDIO_FORMAT=mp3
SPOTLOCAL_OUTPUT_TEMPLATE={artist} - {title}.{output-ext}

# Optional: Spotify API credentials (https://developer.spotify.com/dashboard)
# Not strictly required, but helps prevent spotDL rate-limits
# SPOTIFY_CLIENT_ID=your_client_id_here
# SPOTIFY_CLIENT_SECRET=your_client_secret_here
